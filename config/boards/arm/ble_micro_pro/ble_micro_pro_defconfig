# BLE Micro Pro (nRF52840, Adafruit UF2 bootloader at 0x26000)

# BMP hardware essentials (needed for ANY build, incl. config-less shields): no
# 32kHz crystal -> RC oscillator; P0.10 (NFC2) freed for GPIO use.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
CONFIG_NFCT_PINS_AS_GPIOS=y

CONFIG_ARM_MPU=y
CONFIG_PINCTRL=y
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
